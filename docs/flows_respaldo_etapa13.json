    {
        "id": "6e3642766d9b2f65",
        "type": "function",
        "z": "30fe27e0d08c6026",
        "name": "SIMULACIÓN",
        "func": "// DATOS SIMULADOS: no provienen del PLC.\n// Ciclo de 40 s: 30 s en marcha, 10 s detenido. Un producto nuevo cada 10 s.\nconst POS_ENTRADA = 0.19;\nconst POS_SALIDA  = 0.81;\nconst AVANCE      = 1 / 8;    // el producto cruza la banda en 8 s\n\nlet s = context.get(\"sim\") || { tick: 0, productos: [], contador: 0 };\ns.tick++;\n\nconst motor = (s.tick % 40) < 30;\n\nif (motor) {\n    if (s.tick % 10 === 5) s.productos.push(0);\n    const siguientes = [];\n    s.productos.forEach((p) => {\n        const nueva = p + AVANCE;\n        if (p < POS_SALIDA && nueva >= POS_SALIDA) s.contador++;\n        if (nueva <= 1) siguientes.push(nueva);\n    });\n    s.productos = siguientes;\n}\ncontext.set(\"sim\", s);\n\nconst cerca = (pos) => s.productos.some((p) => Math.abs(p - pos) < 0.07);\n\nmsg.payload = {\n    origen: \"SIMULACION\",\n    timestamp: new Date().toISOString(),\n    motor: motor,\n    sensorEntrada: cerca(POS_ENTRADA),\n    sensorSalida: cerca(POS_SALIDA),\n    productos: s.contador,\n    modo: \"AUTOMÁTICO\",\n    alarmas: motor ? [] : [{ codigo: \"SIM-01\", mensaje: \"Motor detenido (alarma simulada)\" }]\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
