    {
        "id": "d9473d20926c4bc3",
        "type": "function",
        "z": "1d796f1014a01996",
        "name": "Armar datos (SIMULACION)",
        "func": "// Convierte las lecturas OPC UA al formato que espera la interfaz.\n// IMPORTANTE: cambiar ORIGEN a \"PLC\" SOLO cuando la fuente sea el PLC real.\nconst ORIGEN = \"SIMULACION\";\n\nconst NOMBRES = {\n    \"ns=1;s=motor\": \"motor\",\n    \"ns=1;s=sensorEntrada\": \"sensorEntrada\",\n    \"ns=1;s=sensorSalida\": \"sensorSalida\",\n    \"ns=1;s=productos\": \"productos\"\n};\n\nconst campo = NOMBRES[msg.topic];\nif (!campo) return null;                 // lectura desconocida: se ignora\n\nlet valores = context.get(\"valores\") || {};\nvalores[campo] = msg.payload;\ncontext.set(\"valores\", valores);\n\n// No se envía nada hasta tener las 4 variables\nconst completo = Object.values(NOMBRES).every((n) => valores[n] !== undefined);\nif (!completo) return null;\n\n// \"modo\" y \"alarmas\" NO se envían: este servidor no tiene esas señales.\nreturn {\n    payload: {\n        origen: ORIGEN,\n        timestamp: new Date().toISOString(),\n        motor: valores.motor,\n        sensorEntrada: valores.sensorEntrada,\n        sensorSalida: valores.sensorSalida,\n        productos: valores.productos\n    }\n};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
